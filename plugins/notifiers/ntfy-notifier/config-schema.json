{
  "type": "object",
  "title": "settings.title",
  "required": [
    "topic"
  ],
  "properties": {
    "url": {
      "type": "string",
      "title": "settings.url.title",
      "description": "settings.url.description",
      "default": "https://ntfy.sh"
    },
    "topic": {
      "type": "string",
      "title": "settings.topic.title",
      "description": "settings.topic.description"
    },
    "token": {
      "type": "string",
      "title": "settings.token.title",
      "description": "settings.token.description",
      "writeOnly": true
    },
    "style": {
      "type": "string",
      "title": "settings.style.title",
      "description": "settings.style.description",
      "enum": [
        "text",
        "markdown"
      ],
      "default": "text"
    },
    "routing": {
      "type": "object",
      "title": "settings.routing.title",
      "description": "settings.routing.description",
      "additionalProperties": false,
      "properties": {
        "notify_on": {
          "type": "array",
          "title": "settings.routing.notify_on.title",
          "description": "settings.routing.notify_on.description",
          "items": {
            "type": "string"
          }
        },
        "min_severity": {
          "type": "string",
          "title": "settings.routing.min_severity.title",
          "description": "settings.routing.min_severity.description",
          "enum": [
            "info",
            "warn",
            "error",
            "critical"
          ]
        },
        "quiet_hours": {
          "type": "string",
          "title": "settings.routing.quiet_hours.title",
          "description": "settings.routing.quiet_hours.description"
        },
        "max_per_hour": {
          "type": "integer",
          "title": "settings.routing.max_per_hour.title",
          "description": "settings.routing.max_per_hour.description",
          "minimum": 1
        },
        "dedup_window_secs": {
          "type": "integer",
          "title": "settings.routing.dedup_window_secs.title",
          "description": "settings.routing.dedup_window_secs.description",
          "minimum": 1
        }
      }
    }
  }
}
